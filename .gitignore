# RED Core .gitignore

# Model files (too large for GitHub)
models/*.gguf
models/*.bin
models/*.safetensors
models/.cache/

# HuggingFace & AI caches
.cache/
.cache/huggingface/
.cache/puppeteer/

# IDE / Antigravity extensions
.antigravity/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/
*.spec.bak

# Audio cache
cache/audio/

# Logs
logs/
*.log

# Compiled RED binary
dist/
*.exe
red_build/

# Config with secrets
config/red_memory.json

# Node modules
node_modules/

# .NET build outputs
ui/src/DynamicWin/bin/
ui/src/DynamicWin/obj/

# OS
.DS_Store
Thumbs.db
desktop.ini
